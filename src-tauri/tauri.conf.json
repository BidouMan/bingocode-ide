{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "BingoCode",
  "version": "0.5.5",
  "identifier": "com.bingocode.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "BingoCode IDE v0.5.5",
        "width": 1000,
        "height": 650,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "resources": [
      "../engine/*.py",
      "../engine/models/*",
      "../engine/assets/**/*",
      "../engine/portable-python/**/*",
      "../engine/requirements.txt"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBQ0U2Njk2NjNENEVCQwpSV1M4VGoxbWFlYXNEUE8wTm1aanJMQ1FLcFZXNDhjMXI4c3BLMFUwQm5WcG4yVlhBK3ZqOXhPZgo=",
      "endpoints": [
        "https://cdn.jsdelivr.net/gh/BidouMan/bingocode-ide@latest/latest.json",
        "https://ghfast.top/https://github.com/BidouMan/bingocode-ide/releases/latest/download/latest.json",
        "https://github.com/BidouMan/bingocode-ide/releases/latest/download/latest.json"
      ]
    }
  }
}
